#!/usr/bin/env python3
"""Run pure-Python validation and optional headless Isaac Sim scene tests."""

from __future__ import annotations

import argparse
from pathlib import Path
import subprocess
import sys

# Allow execution from the source checkout.
PACKAGE_ROOT = Path(__file__).resolve().parents[1]
if not (PACKAGE_ROOT / "test").is_dir():
    PACKAGE_ROOT = Path.cwd().resolve()

if str(PACKAGE_ROOT) not in sys.path:
    sys.path.insert(0, str(PACKAGE_ROOT))

from dvrk_isaac_sim.scene import (
    available_scene_names,
    load_simulator_config,
)


def _run(command: list[str], label: str) -> str:
    print(f"\n== {label} ==", flush=True)
    print("$ " + " ".join(command), flush=True)
    result = subprocess.run(
        command, cwd=PACKAGE_ROOT, check=True, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
    )
    print(result.stdout, end="", flush=True)
    return result.stdout


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--config", type=Path, default=PACKAGE_ROOT / "share/isaac_sim.yaml",
        help="simulator configuration YAML",
    )
    parser.add_argument(
        "--skip-isaac", action="store_true",
        help="run Python/configuration tests only",
    )
    parser.add_argument(
        "--scene", action="append",
        help="run Isaac Sim for only this scene; repeat for multiple scenes",
    )
    args = parser.parse_args()
    config_path = args.config.expanduser().resolve()

    _run(
        [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider"],
        "pure-Python tests",
    )
    _run(
        [sys.executable, str(PACKAGE_ROOT / "scripts/validate_config.py"),
         "--config", str(config_path)],
        "configuration validation",
    )

    if args.skip_isaac:
        print("\nIsaac Sim tests skipped by request.", flush=True)
        return 0

    simulator = load_simulator_config(config_path)
    if simulator.isaac_sim_dir is None:
        raise RuntimeError(
            f"{config_path}: isaac_sim_dir is required for headless tests; "
            "use --skip-isaac to run Python tests only"
        )
    isaac_python = simulator.isaac_sim_dir / "python.sh"
    if not isaac_python.is_file():
        raise FileNotFoundError(
            f"Isaac Sim python.sh not found: {isaac_python}; "
            "use --skip-isaac to run Python tests only"
        )

    scenes = args.scene or list(available_scene_names(config_path))
    if not scenes:
        raise RuntimeError(f"No scenes found below {config_path.parent / 'scenes'}")

    for scene in scenes:
        output = _run(
            [
                "ros2", "launch", "dvrk_isaac_sim", "simulator.launch.py",
                f"config:={config_path}", f"scene:={scene}",
                "headless:=true", "duration:=0.25",
            ],
            f"headless Isaac Sim scene: {scene}",
        )
        if "Traceback (most recent call last)" in output or "[py stderr]" in output and "Error" in output:
            raise RuntimeError(f"Isaac Sim reported a Python/runtime error for scene {scene}")
    print(f"\nAll checks passed ({len(scenes)} Isaac Sim scene(s)).", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
